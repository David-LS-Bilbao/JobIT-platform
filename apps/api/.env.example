# Backend JobIT API — plantilla de entorno local (SIN secretos reales).
# Copia este archivo a apps/api/.env y rellena valores locales:
#   cp apps/api/.env.example apps/api/.env
# apps/api/.env esta IGNORADO por Git: NUNCA lo versiones ni publiques sus valores.

# Modo de ejecucion: development | production | test
NODE_ENV="development"

# Puerto del servidor Express (la API escucha aqui en dev)
PORT=4000

# Origen permitido para CORS con credenciales (frontend en dev).
# IMPORTANTE: debe COINCIDIR con el puerto REAL del frontend.
# Si el 3000 esta ocupado (p. ej. por Docker) y el web arranca en 3001,
# pon aqui http://localhost:3001; de lo contrario el login falla por CORS.
CORS_ORIGIN="http://localhost:3001"

# Conexion a PostgreSQL para dev/smoke.
# Usa una base SEPARADA (jobit_dev); NO uses la base de test (jobit_test).
# Ajusta usuario/clave/host/puerto a tu contenedor local (jobit-postgres-dev usa 5432).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobit_dev?schema=public"

# Conexion a PostgreSQL para los tests (vitest). Base INDEPENDIENTE: los tests la
# migran y truncan en cada ejecucion, por lo que NO debe apuntar a jobit_dev.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/jobit_test?schema=public"

# Secretos JWT (obligatorios). Genera valores largos y aleatorios en local:
#   openssl rand -hex 48
JWT_ACCESS_SECRET="replace-with-a-long-random-local-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-local-refresh-secret"

# Opcional: solo si se activa el cliente real de Jooble. No es necesario para el smoke.
JOOBLE_API_KEY=""
