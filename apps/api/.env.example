# Backend JobIT API — plantilla de entorno local (SIN secretos reales).
# Copia este archivo a apps/api/.env y rellena valores locales:
#   cp apps/api/.env.example apps/api/.env
# apps/api/.env esta IGNORADO por Git: NUNCA lo versiones ni publiques sus valores.

# Modo de ejecucion: development | production | test
NODE_ENV="development"

# Puerto del servidor Express (la API escucha aqui en dev)
PORT=4000

# Origen permitido para CORS con credenciales (frontend en dev).
# IMPORTANTE: debe COINCIDIR con el puerto REAL del frontend.
# Si el 3000 esta ocupado (p. ej. por Docker) y el web arranca en 3001,
# pon aqui http://localhost:3001; de lo contrario el login falla por CORS.
CORS_ORIGIN="http://localhost:3001"

# Conexion a PostgreSQL para dev/smoke.
# Usa una base SEPARADA (jobit_dev); NO uses la base de test (jobit_test).
# Ajusta usuario/clave/host/puerto a tu contenedor local (jobit-postgres-dev usa 5432).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobit_dev?schema=public"

# Conexion a PostgreSQL para los tests (vitest). Base INDEPENDIENTE: los tests la
# migran y truncan en cada ejecucion, por lo que NO debe apuntar a jobit_dev.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/jobit_test?schema=public"

# Secretos JWT (obligatorios). Genera valores largos y aleatorios en local:
#   openssl rand -hex 48
JWT_ACCESS_SECRET="replace-with-a-long-random-local-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-local-refresh-secret"

# --- Rate limiting de la API (B3-ABUSE-01) ---
# Spec: docs/specs/features/api-rate-limiting.md
# Todas son OPCIONALES: si faltan, se aplican los defaults productivos. Solo
# enteros; un valor invalido aborta el arranque con un error explicito.

# Limitador general (todo /api y /uploads). Ventana en ms (1000..3600000).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Login reforzado (POST /api/auth/login). Solo cuentan los intentos FALLIDOS.
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX=10

# Registro reforzado (POST /api/auth/register). Cuentan TODOS los intentos.
# Ventana en ms (1000..86400000).
AUTH_REGISTER_WINDOW_MS=3600000
AUTH_REGISTER_MAX=5

# Portfolio publico (GET /api/public/portfolios/:slug): unica superficie
# publica con datos personales.
PUBLIC_READ_WINDOW_MS=900000
PUBLIC_READ_MAX=60

# Numero de saltos de proxy de confianza (0..10) para app.set("trust proxy", n).
# 0 = sin proxy (local, tests, CI): X-Forwarded-For se IGNORA.
# 1 = un unico reverse proxy delante (staging/produccion tras Nginx Proxy Manager).
# NUNCA uses true: permitiria falsificar la IP del cliente y evadir el limite.
TRUST_PROXY_HOPS=0

# Opcional: solo si se activa el cliente real de Jooble. No es necesario para el smoke.
# NUNCA commitear su valor real (vive solo en apps/api/.env, ignorado por Git).
JOOBLE_API_KEY=""

# Host/base URL de la API de Jooble (opcional). Default global: https://jooble.org/api
# Algunas API keys son REGIONALES: usa el host de tu region o daran 403.
# Para Espana: https://es.jooble.org/api
JOOBLE_API_BASE_URL="https://jooble.org/api"

# Greenhouse Job Board API (ATS publico, por empresa). Endpoint PUBLICO sin auth: NO hay
# API key ni secreto. La lista curada de empresas (board_token -> company) vive versionada
# en el codigo (src/jobs/external/greenhouse/greenhouse.companies.ts), NO aqui.
GREENHOUSE_API_BASE_URL="https://boards-api.greenhouse.io/v1/boards"
# Opcional para el script de ingesta de Greenhouse (backend-only):
#   ING_GREENHOUSE_TOKENS=""            # Opcional: limitar a un subset revisado de GREENHOUSE_COMPANIES
#   ING_LIMIT tambien aplica (nº maximo de ofertas por board)

# Parametros OPCIONALES de los scripts de ingesta MANUAL (backend-only). La API no los
# necesita para arrancar; solo los leen los comandos de ingesta. Descomenta si quieres
# fijar defaults locales:
#   ING_KEYWORDS=developer
#   ING_LOCATION=Espana                                    # ingesta de una sola ubicacion
#   ING_LOCATIONS=Bilbao,Madrid,Barcelona,Remoto,Espana    # CSV multi-ubicacion (fallback a ING_LOCATION)
#   ING_LIMIT=20                                           # nº de ofertas por ubicacion (1..50)
