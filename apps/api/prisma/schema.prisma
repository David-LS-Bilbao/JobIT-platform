generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  role              String             @default("CANDIDATE")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  refreshTokens     RefreshToken[]
  profile           CandidateProfile?
  savedJobs         SavedJob[]
  portfolioSettings PortfolioSettings?
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AvailabilityStatus {
  ACTIVE
  OPEN
  NOT_LOOKING
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum LinkType {
  GITHUB
  LINKEDIN
  PORTFOLIO
  OTHER
}

enum RemotePreference {
  REMOTE
  HYBRID
  ON_SITE
  ANY
}

enum Seniority {
  JUNIOR
  MID
  SENIOR
}

model CandidateProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  firstName          String?
  lastName           String?
  headline           String?
  summary            String?
  location           String?
  locationRemote     Boolean            @default(false)
  availabilityStatus AvailabilityStatus @default(ACTIVE)
  avatarUrl          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             Skill[]
  experiences        Experience[]
  education          Education[]
  projects           Project[]
  links              Link[]
  preferences        JobPreferences?
}

// JobIT Portfolio V1: configuración privada de publicación del portfolio público.
// No almacena HTML ni snapshot del perfil: el portfolio se proyecta en vivo desde
// el CandidateProfile. Solo guarda slug, estado de publicación y flags de visibilidad.
model PortfolioSettings {
  id               String    @id @default(uuid())
  userId           String    @unique
  slug             String    @unique
  isPublished      Boolean   @default(false)
  publishedAt      DateTime?
  showLocation     Boolean   @default(true)
  showAvailability Boolean   @default(true)
  showPreferences  Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id             String           @id @default(uuid())
  profileId      String
  name           String
  normalizedName String
  level          SkillLevel?
  category       String?
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, normalizedName])
}

model Experience {
  id          String           @id @default(uuid())
  profileId   String
  company     String
  role        String
  startDate   DateTime
  endDate     DateTime?
  current     Boolean          @default(false)
  description String?
  location    String?
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id          String           @id @default(uuid())
  profileId   String
  institution String
  title       String
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean          @default(false)
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id           String           @id @default(uuid())
  profileId    String
  name         String
  description  String?
  technologies String[]
  url          String?
  repoUrl      String?
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Link {
  id        String           @id @default(uuid())
  profileId String
  type      LinkType
  url       String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model JobPreferences {
  id                 String           @id @default(uuid())
  profileId          String           @unique
  desiredRoles       String[]
  preferredLocations String[]
  remotePreference   RemotePreference @default(ANY)
  seniority          Seniority?
  salaryMin          Int?
  salaryMax          Int?
  contractTypes      String[]
  profile            CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum RemoteType {
  REMOTE
  HYBRID
  ON_SITE
  UNSPECIFIED
}

enum JobSource {
  INTERNAL
  JOOBLE
  ADZUNA
}

enum JobSeniority {
  JUNIOR
  MID
  SENIOR
  ANY
}

enum JobStatus {
  ACTIVE
  CLOSED
}

model Job {
  id           String       @id @default(uuid())
  title        String
  company      String
  location     String?
  remoteType   RemoteType
  description  String
  requirements String[]
  seniority    JobSeniority
  contractType String
  salaryMin    Int?
  salaryMax    Int?
  tags         String[]
  status       JobStatus    @default(ACTIVE)
  postedAt     DateTime     @default(now())
  expiresAt    DateTime?

  source     JobSource @default(INTERNAL)
  externalId String?
  sourceUrl  String?
  ingestedAt DateTime?

  savedBy SavedJob[]

  @@index([status])
  @@index([remoteType])
  @@index([seniority])
  @@index([contractType])
  @@index([postedAt])
  @@index([source])
}

model SavedJob {
  id      String   @id @default(uuid())
  userId  String
  jobId   String
  savedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([savedAt])
}
