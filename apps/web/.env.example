# Configuración pública del frontend JobIT (sin secretos).
# Base URL del backend (API Express). En desarrollo el backend corre en :4000.
# Copia este archivo a .env.local para desarrollo. NUNCA pongas secretos en NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# URL publica ABSOLUTA de la web, usada para construir el enlace y el QR del
# portfolio publico (AUDIT03-URL-SCHEME-01). Se INLINEA en el build de Next:
# cambiarla exige reconstruir la imagen, no basta con reiniciarla.
# En un entorno desplegado es OBLIGATORIA y debe ser https; si falta o no lo es,
# la aplicacion NO ofrece enlace publico en lugar de degradarlo a http.
# En desarrollo puede omitirse: se usa el origen del navegador.
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000
